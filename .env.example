# Copy to .env and adjust. All values are validated at startup (src/config).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SQLite file path (":memory:" for an ephemeral DB)
DATABASE_PATH=./data/ayrshare.db

# TikTok Marketing API: mock | sandbox | live
TIKTOK_MODE=mock
TIKTOK_BASE_URL=https://sandbox-ads.tiktok.com/open_api/v1.3
# Outbound TikTok request rate (sandbox allows 1 QPS) and per-request timeout
TIKTOK_MAX_QPS=1
TIKTOK_TIMEOUT_MS=15000

# Safety limits (USD). Caps apply to worst-case spend (daily budget x days, or the total budget):
# one boost, and the sum of a profile's running boosts.
MAX_SPEND_PER_BOOST=5000
MAX_SPEND_PER_PROFILE=20000
MAX_CAMPAIGN_DAYS=90
